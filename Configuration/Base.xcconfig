#include "Version.xcconfig"

// App identity. A new project changes only these values.
APP_DISPLAY_NAME = Modern.UIKit
APP_BUNDLE_IDENTIFIER = com.example.modernuikit
DEVELOPMENT_TEAM =

// Platforms. Use TARGETED_DEVICE_FAMILY = 1 for iPhone only.
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO

// Shared by the App and AppTests targets. Do not set these in the Xcode
// project, because a project value overrides this file.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
GENERATE_INFOPLIST_FILE = YES
PRODUCT_NAME = $(TARGET_NAME)

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES
CODE_SIGNING_SUPPORTED = YES
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER)
PROVISIONING_PROFILE_SPECIFIER =
